# Configuración de Supabase
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Clave de servicio para tareas administrativas en el backend (opcional para recordatorios automáticos)
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Configuración de Envío de Correo Electrónico (Resend)
# Obtén tu API Key en https://resend.com/api-keys
RESEND_API_KEY=re_tu_clave_de_resend
# Remitente verificado (opcional; por defecto usa onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL="OdontoControl <onboarding@resend.dev>"

# Configuración de WhatsApp Cloud API (Meta for Developers - Opcional para envíos 100% en servidor)
WHATSAPP_CLOUD_API_TOKEN=tu_token_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
